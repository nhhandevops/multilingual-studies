# deps / build output
node_modules/
dist/
build/
*.tsbuildinfo

# databases & packs (distributed via GitHub Releases, never git history)
# blanket *.gz: pack files and browser-download duplicates (content.db_2.gz etc.) must never be committed
*.db
*.db-wal
*.db-shm
*.gz
apps/web/public/packs/

# raw source dumps (mirrored locally; provenance recorded in sources.lock.json)
apps/ingest/data-cache/

# env & editor
.env
.env.*
.DS_Store

# editor-extension output, not project work: a VS Code extension writes these
# into .github/ on its own schedule. .github/workflows/ is ours and stays tracked.
.github/copilot-instructions.md
.github/instructions/
